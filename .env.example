# Copy to apps/web/.env.local to override. Never commit real values. Every value here is public:
# it is baked into the static site at build time.

# Canonical address of the site, including the GitHub Pages path, no trailing slash.
# CI sets this from GitHub Pages itself (docs/deploy.md), so you only need it locally to test URLs.
NEXT_PUBLIC_SITE_URL=https://cheffycoder.github.io/portfolio
# The path the site is served under ("/portfolio" for a project page, empty for <user>.github.io or a
# custom domain). Read by next.config.ts and the app; CI sets it from GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
# Google Search Console HTML-tag verification code (the content="…" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Analytics: "umami" or "none"
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
