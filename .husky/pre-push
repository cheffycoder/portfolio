# Nobody pushes to main: changes reach it only through a pull request (AGENTS.md › Git).
target=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✗ Pushing to main is not allowed. Push a branch and open a pull request instead."
    exit 1
  fi
  case "$local_sha" in *[!0]*) target="$local_sha" ;; esac
done
[ -z "$target" ] && exit 0

# Check exactly what is being pushed, the way GitHub sees it: a clean copy of the commit, without local
# drafts, ignored files or changes that were never committed.
echo "Checking the pushed commit in a clean copy (what GitHub will see)…"
dir=$(mktemp -d)
git worktree add --detach --quiet "$dir" "$target"
if (cd "$dir" && HUSKY=0 pnpm install --frozen-lockfile --prefer-offline --silent && pnpm check); then
  status=0
else
  status=$?
fi
git worktree remove --force "$dir"
exit $status
